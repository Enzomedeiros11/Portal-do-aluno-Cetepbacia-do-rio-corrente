{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuários do portal acadêmico (Alunos, Professores, Responsáveis e Admin)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "matricula": { "type": "string" },
        "role": { "type": "string" },
        "course": { "type": "string" },
        "grade": { "type": "string" },
        "frequencia": { "type": "number" },
        "subjectGrades": { "type": "object" },
        "emailResponsavel": { "type": "string" },
        "nomeResponsavel": { "type": "string" },
        "telefoneResponsavel": { "type": "string" },
        "avatar": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "PreRegistrationRequest": {
      "title": "PreRegistrationRequest",
      "description": "Solicitações de pré-cadastro de alunos e responsáveis aguardando aprovação do professor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "matricula": { "type": "string" },
        "role": { "type": "string" },
        "course": { "type": "string" },
        "grade": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "evaluatedBy": { "type": "string" },
        "evaluatedAt": { "type": "string" }
      },
      "required": ["name", "email", "matricula", "role", "course", "grade", "status", "createdAt"]
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Alunos e Professores autorizados pela Direção escolar com Matrícula e E-mail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matricula": { "type": "string" },
        "email": { "type": "string" },
        "nome": { "type": "string" },
        "tipo": { "type": "string" },
        "curso": { "type": "string" },
        "grade": { "type": "string" },
        "emailResponsavel": { "type": "string" },
        "nomeResponsavel": { "type": "string" },
        "status": { "type": "string" },
        "cadastradoPor": { "type": "string" },
        "dataCadastro": { "type": "string" }
      },
      "required": ["matricula", "email", "nome", "tipo"]
    },
    "DailyClass": {
      "title": "DailyClass",
      "description": "Publicações dos professores no mural sobre o que vão dar de aula hoje",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "professor": { "type": "string" },
        "professorEmail": { "type": "string" },
        "disciplina": { "type": "string" },
        "curso": { "type": "string" },
        "turma": { "type": "string" },
        "tema": { "type": "string" },
        "conteudo": { "type": "string" },
        "atividades": { "type": "string" },
        "data": { "type": "string" }
      },
      "required": ["professor", "disciplina", "turma", "tema", "conteudo", "data"]
    },
    "Message": {
      "title": "Message",
      "description": "Mensagens de chat e comunicados das turmas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "texto": { "type": "string" },
        "usuario": { "type": "string" },
        "email": { "type": "string" },
        "canal": { "type": "string" },
        "avatar": { "type": "string" },
        "arquivo_url": { "type": "string" },
        "arquivo_nome": { "type": "string" },
        "arquivo_tipo": { "type": "string" },
        "data": { "type": "string" }
      },
      "required": ["texto", "usuario", "email", "canal"]
    },
    "Class": {
      "title": "Class",
      "description": "Turmas acadêmicas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "course": { "type": "string" },
        "grade": { "type": "string" },
        "teacher": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/usuarios/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Coleção de usuários registrados no sistema"
    },
    "/solicitacoes_cadastro/{requestId}": {
      "schema": { "$ref": "#/entities/PreRegistrationRequest" },
      "description": "Solicitações de pré-cadastro pendentes de aprovação pelo professor"
    },
    "/autorizados/{authId}": {
      "schema": { "$ref": "#/entities/AuthorizedUser" },
      "description": "Lista de matrículas e e-mails autorizados pela Direção"
    },
    "/aulas_hoje/{aulaId}": {
      "schema": { "$ref": "#/entities/DailyClass" },
      "description": "Mural de postagens dos professores sobre aulas do dia"
    },
    "/mensagens/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Coleção de mensagens de chat e comunicados"
    },
    "/turmas/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Coleção de turmas e salas"
    }
  }
}
